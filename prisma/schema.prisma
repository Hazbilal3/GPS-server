generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  driverId           Int?      @unique
  email              String    @unique
  password           String?   // null = pending registration (driver sets own password via mobile)
  userRole           Int
  adminId            Int?
  fullName           String?
  phoneNumber        String?   @unique @db.VarChar(20)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  exports            Export[]
  uploads            Upload[]
  payrolls           Payroll[]
  disputes           Dispute[]
  orderDisputes      OrderDispute[]
  resetCodeHash        String?
  resetCodeExpiresAt   DateTime?
  resetCodeAttempts    Int       @default(0)
  pushToken            String?
  salaryType           String?
  fixedSalary          Float?
  schedule             String[]
  status               String?   @default("Active")
  driverAvailableToday Boolean?  @default(false)
  insuranceNumber      String?
  insuranceExpiry      DateTime?
  registrationNumber   String?
  registrationExpiry   DateTime?
  licenseNumber        String?
  licenseExpiry        DateTime?
  state                String?
  operatingType        String?   // "individual" | "company"
  // --- New: self-registration flow ---
  emailVerified        Boolean   @default(false)
  emailOtpHash         String?
  emailOtpExpiresAt    DateTime?
  poolStatus           String?   // null | "pending" | "approved" | "rejected"
  poolEntry            DriverPool?
  tokenExpiresAt       DateTime?
  profileImageUrl      String?
  vehicleSize          String?
  gustoComplete        Boolean   @default(false)
  openforceComplete    Boolean   @default(false)
  agreements           DriverAgreement[]
}

model Upload {
  id         Int      @id @default(autoincrement())
  driverId   Int?
  user       User?    @relation(fields: [driverId], references: [driverId])
  barcode    String
  sequenceNo String?
  lastevent  String?
  address    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  salaryType String?
  rate       Float?
  pieces     Int?
  zipCode    String?
  city       String?
  exports    Export[]

  @@index([driverId, createdAt])
  @@index([driverId, lastevent])
}

model Export {
  id             Int      @id @default(autoincrement())
  driverId       Int
  barcode        String
  address        String
  gpsLocation    String?
  expectedLat    Float?
  expectedLng    Float?
  distanceKm     Float?
  status         String?
  matches        String
  googleMapsLink String?
  uploadId       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [driverId], references: [id])
  upload         Upload?  @relation(fields: [uploadId], references: [id])
}

model Payroll {
  id              Int      @id @default(autoincrement())
  driverId        Int
  driverName      String
  zipCode         String?
  zipBreakdown    Json?
  address         String?
  weekNumber      Int // <-- CHANGED: Was Int?
  payPeriod       String?
  salaryType      String?
  stopsCompleted  Int
  totalDeliveries Int?
  amount          Float
  totalDeduction  Float    @default(0)
  totalBonus      Float    @default(0)
  netPay          Float
  remarks         String?
  bonusRemarks    String?
  paymentStatus   String   @default("unpaid")
  createdAt       DateTime @default(now())

  driver User @relation(fields: [driverId], references: [driverId])

  @@unique([driverId, weekNumber])
  @@index([weekNumber])
}

model Route {
  id                        Int      @id @default(autoincrement())
  routeNumber               String?  @map("route_number") // e.g. '222'
  description               String   @map("description") // e.g. 'PAWCUTUCK'
  ratePerStop               Float    @map("rate_per_stop") // e.g. 2.35
  territory                 String?  @map("territory") // e.g. 'T1'
  zone                      String?  @map("zone") // e.g. 'Zone B'
  status                    String?  @map("status") // e.g. 'Active'
  baseRate                  Float?   @map("base_rate") // e.g. 'Active'
  baseRateCompanyVehicle    Float?   @map("base_rate_company_vehicle") // e.g. 'Active'
  schedule                  String[] @map("schedule") // array of weekdays
  zipCode                   String[] @map("zip_code") // array of ZIPs ['6379']
  dayOfTheWeek              String?  @map("day_of_the_week") // e.g. 'Tuesday'
  routeScheduledForToday    String?  @map("route_scheduled_for_today") // e.g. 'Yes'
  ratePerStopCompanyVehicle Float?   @map("rate_per_stop_company_vehicle") // e.g. 2
  route                     String?  @map("route") // e.g. '222 (PAWCUTUCK)'
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}


model Dispute {
  id         Int              @id @default(autoincrement())
  driverId   Int
  driverName String
  title      String
  status     String           @default("open")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   DisputeMessage[]
  driver     User             @relation(fields: [driverId], references: [driverId])

  @@index([driverId])
}

model DisputeMessage {
  id            Int      @id @default(autoincrement())
  disputeId     Int
  senderRole    String
  senderName    String
  content       String
  attachmentUrl String?
  isRead        Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model OrderDispute {
  id                Int      @id @default(autoincrement())
  driverId          Int
  driverName        String
  date              DateTime
  orderNumber       String
  expectedLocation  String
  deliveredLocation String
  imageUrl          String?
  status            String   @default("open")
  createdByName     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  driver            User     @relation(fields: [driverId], references: [driverId])

  @@index([driverId])
}

model DriverDocument {
  id          Int      @id @default(autoincrement())
  driverId    Int
  fileName    String
  storedName  String
  description String
  fileUrl     String
  status      String   @default("pending") // "pending" | "verified"
  createdAt   DateTime @default(now())
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  driverId   Int
  driverName String
  date       DateTime
  reason     String
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([driverId])
  @@index([status])
}

model SpecialOrder {
  id                Int                  @id @default(autoincrement())
  routeName         String
  stops             Int
  date              DateTime
  price             Float
  description       String?
  status            String               @default("pending") // "pending" | "accepted" | "rejected"
  targetType        String               // "specific" | "all"
  targetDriverIds   Json?                // array of driverIds e.g. [12345, 254306]
  rejectedBy        Json?                // array of driverIds who rejected
  acceptedBy        Int?
  acceptedByName    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  earning           SpecialOrderEarning?
  // Custom route extra fields
  pickupAddress     String?
  deliveryAddress   String?
  pickupTime        String?
  dropoffTime       String?
  duration          String?
  vehicleSize       String?
  miles             Float?
  pieces            Int?
  itemWeight        Float?
  pickupPersonName  String?
  pickupPersonPhone String?
  dropoffPersonName String?
  dropoffPersonPhone String?
  // Driver delivery flow
  driverStatus      String?  // null | "picked_up" | "delivered"
  pickupPhotoUrl    String?
  deliveryPhotoUrl  String?
  payrollStatus     String?  // null | "pending" | "approved" | "rejected"
}

model AvailableDriver {
  id        Int      @id @default(autoincrement())
  driverId  Int      @unique
  createdAt DateTime @default(now())
}

model DriverNotification {
  id        Int      @id @default(autoincrement())
  driverId  Int
  title     String
  body      String
  type      String?
  orderId   Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([driverId])
}

model SpecialOrderEarning {
  id             Int          @id @default(autoincrement())
  specialOrderId Int          @unique
  driverId       Int          // business driverId
  weekNumber     Int
  date           DateTime     // exact date of the special order
  amount         Float
  routeName      String
  stops          Int
  createdAt      DateTime     @default(now())
  specialOrder   SpecialOrder @relation(fields: [specialOrderId], references: [id], onDelete: Cascade)

  @@index([driverId, weekNumber])
}

model NotificationTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  title     String   @default("")
  message   String   @default("")
  createdAt DateTime @default(now())
}

model PayrollAdjustment {
  id         Int      @id @default(autoincrement())
  driverId   Int
  weekNumber Int
  date       String   // YYYY-MM-DD — the specific day this applies to
  type       String   // "deduction" | "bonus"
  amount     Float
  reason     String
  createdAt  DateTime @default(now())

  @@index([driverId, weekNumber])
  @@index([driverId, date])
}

model AssignDraft {
  id        Int      @id @default(autoincrement())
  name      String
  rows      Json     // Array of { driverId: number, routes: string[] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollRateOverride {
  id           Int      @id @default(autoincrement())
  driverId     Int
  zipCode      String
  date         String   // YYYY-MM-DD stored as string to avoid timezone issues
  originalRate Float
  newRate      Float
  changedBy    String
  changedAt    DateTime @default(now())

  @@unique([driverId, zipCode, date])
}

model DriverSchedule {
  id         Int      @id @default(autoincrement())
  driverId   Int
  driverName String
  date       String   // YYYY-MM-DD
  status     String   @default("available") // "available" | "off"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([driverId, date])
  @@index([date])
}

model DriverPool {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id])
  fullName         String
  email            String
  phoneNumber      String?
  state            String?
  operatingType    String?   // "individual" | "company"
  // Insurance
  insuranceNumber  String?
  insuranceExpiry  DateTime?
  insuranceDocUrl  String?
  // Registration
  registrationNumber String?
  registrationExpiry DateTime?
  registrationDocUrl String?
  // License
  licenseNumber    String?
  licenseExpiry    DateTime?
  licenseDocUrl    String?
  w9DocUrl         String?
  // Legacy single-doc fields (kept nullable for backward compat)
  docName          String?
  docUrl           String?
  status           String    @default("pending") // "pending" | "approved" | "rejected"
  assignedDriverId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model EarlyPayoutRequest {
  id             Int      @id @default(autoincrement())
  payrollId      Int?
  driverId       Int
  driverName     String
  weekNumber     Int
  reason         String
  requestedDates String[] // days driver selected when submitting the request
  status         String   @default("pending") // "pending" | "approved" | "denied"
  adminNote      String?
  paidDates      String[] // days admin confirms on approval
  paidAmount     Float?   // total amount paid early (net, after app fee)
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([driverId])
}

model DriverAgreement {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  agreementType String   // "TERMS_OF_USE" | "IC_AGREEMENT"
  version       String   @default("1.0")
  signedAt      DateTime @default(now())
  signatureName String

  @@unique([userId, agreementType])
  @@index([userId])
}

// ─────────────────────────────────────────────
// EXPEDITED / FREIGHT MODULE (separate from Last Mile)
// ─────────────────────────────────────────────

model FreightDriver {
  id            Int      @id @default(autoincrement())
  name          String
  email         String?  @unique
  passwordHash  String?  // set by admin to enable driver login
  phone         String?
  licenseNumber String?
  licenseExpiry DateTime?
  status        String   @default("active") // "active" | "inactive"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loads       FreightLoad[]
  clockSessions FreightClockSession[]
  preTripInspections FreightPreTrip[]
}

model FreightTruck {
  id           Int      @id @default(autoincrement())
  name         String   // e.g. "Truck 1", "Van A"
  type         String   // "cargo_van" | "box_truck_16" | "box_truck_26" | "semi"
  plateNumber  String?
  status       String   @default("active") // "active" | "inactive" | "maintenance"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loads        FreightLoad[]
  clockSessions FreightClockSession[]
}

model FreightLoad {
  id              Int      @id @default(autoincrement())

  // Order info
  loadNumber        String?
  company           String?  // "BTX" | "BOL_OKEE" | "BOL_MERGE" | "RATE_CON"
  orig              String?  // origin airport/hub code
  dest              String?  // destination airport/hub code
  serviceType       String?  // "Next Day" | "Same Day" | "Ground" etc.
  shipmentValue     String?  // e.g. "NVD" or "$1200"
  agreedRate        Float?
  driverPay         Float?

  // Pickup (Shipper)
  pickupCompany     String?
  pickupAddress     String?
  pickupCity        String?
  pickupState       String?
  pickupZip         String?
  pickupPhone       String?
  pickupContact     String?
  pickupDate        DateTime?
  pickupReadyTime   String?  // HH:MM
  pickupCloseTime   String?  // HH:MM
  pickupNotes       String?

  // Delivery (Consignee)
  deliveryCompany   String?
  deliveryAddress   String?
  deliveryCity      String?
  deliveryState     String?
  deliveryZip       String?
  deliveryContact   String?
  deliveryDate      DateTime?   // delivery deadline date
  deliveryTime      String?     // delivery deadline time e.g. "17:00"
  deliveryOpenTime  String?     // HH:MM
  deliveryCloseTime String?     // HH:MM
  deliveryNotes     String?

  // References
  poNumber          String?
  soNumber          String?
  invoiceRef        String?
  reference1        String?
  reference2        String?
  reference3        String?

  // Additional services & instructions
  additionalServices String?   // comma-separated e.g. "Liftgate DL, Packaging Disposal"
  specialInstructions String?

  // Cargo (single row)
  pieces            Int?
  weight            Float?
  cargoLength       Float?
  cargoWidth        Float?
  cargoHeight       Float?
  cargoExt          Float?
  cargoDim          String?
  packageType       String?
  commodity         String?  // cargo description

  internalNotes     String?

  // Assignment
  driverId         Int?
  truckId          Int?
  driver           FreightDriver? @relation(fields: [driverId], references: [id])
  truck            FreightTruck?  @relation(fields: [truckId], references: [id])

  // Status flow
  status           String   @default("unassigned")
  // unassigned → assigned → pre_trip_required → pre_trip_complete → clocked_in →
  // en_route_pickup → at_pickup → loaded → in_transit → at_delivery →
  // delivered → pod_required → pod_received → ready_for_billing →
  // invoice_review → invoiced → awaiting_payment → payment_overdue → paid → closed

  // Delivery outcome
  deliveredInFull  Boolean?
  deliveryException Boolean? @default(false)
  exceptionNotes   String?

  // POD
  podUrl           String?  // uploaded proof of delivery
  podUploadedAt    DateTime?

  // Billing
  invoiceNumber    String?
  invoiceAmount    Float?
  invoiceDate      DateTime?
  invoiceSentAt    DateTime?
  invoiceRecipients String?
  invoiceNotes     String?
  paymentTerms     String?  // "Net 15" | "Net 21" | "Net 30" | "Net 45"
  paymentDueDate   DateTime?
  amountPaid       Float?   @default(0)
  paidAt           DateTime?
  billingStatus    String?  // "draft" | "sent" | "partial" | "paid" | "disputed"
  // Billing contact (Invoice for section)
  billingCompany   String?
  billingContact   String?
  billingEmail     String?
  billingPhone     String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clockSessions    FreightClockSession[]
  milestones       FreightMilestone[]
  preTripInspections FreightPreTrip[]
  documents        FreightDocument[]

  @@index([status])
  @@index([driverId])
}

model FreightPreTrip {
  id         Int      @id @default(autoincrement())
  loadId     Int
  driverId   Int
  load       FreightLoad   @relation(fields: [loadId], references: [id])
  driver     FreightDriver @relation(fields: [driverId], references: [id])

  // YES/NO safety checks (true = pass, false = fail)
  license           Boolean?
  medicalCard       Boolean?
  registration      Boolean?
  insurance         Boolean?
  logbookEld        Boolean?
  lights            Boolean?
  horn              Boolean?
  tires             Boolean?
  lugNuts           Boolean?
  windshield        Boolean?
  wipers            Boolean?
  washerFluid       Boolean?
  mirrors           Boolean?
  brakes            Boolean?
  leaks             Boolean?
  fuel              Boolean?
  // Equipment checks
  bolPaperwork      Boolean?
  palletJack        Boolean?
  strapsSecurement  Boolean?

  passed     Boolean  @default(false) // true only if no serious safety fail
  notes      String?
  completedAt DateTime @default(now())

  @@index([loadId])
  @@index([driverId])
}

model FreightClockSession {
  id         Int      @id @default(autoincrement())
  loadId     Int
  driverId   Int
  truckId    Int?
  load       FreightLoad   @relation(fields: [loadId], references: [id])
  driver     FreightDriver @relation(fields: [driverId], references: [id])
  truck      FreightTruck? @relation(fields: [truckId], references: [id])

  clockInAt   DateTime
  clockInLat  Float?
  clockInLng  Float?
  clockOutAt  DateTime?
  clockOutLat Float?
  clockOutLng Float?
  totalMinutes Int?

  // Admin correction log (JSON array of corrections)
  corrections Json?   // [{ originalIn, originalOut, correctedIn, correctedOut, adminId, reason, at }]

  createdAt   DateTime @default(now())

  @@index([loadId])
  @@index([driverId])
}

model FreightMilestone {
  id         Int      @id @default(autoincrement())
  loadId     Int
  load       FreightLoad @relation(fields: [loadId], references: [id])

  milestone  String   // "clocked_in" | "en_route_pickup" | "arrived_pickup" | "loaded" |
                      // "departed_pickup" | "in_transit" | "arrived_delivery" |
                      // "delivered" | "pod_uploaded" | "clocked_out"
  recordedAt DateTime @default(now())
  lat        Float?
  lng        Float?
  notes      String?

  @@index([loadId])
}

model FreightDocument {
  id          Int      @id @default(autoincrement())
  loadId      Int
  load        FreightLoad @relation(fields: [loadId], references: [id])

  type        String   // "rate_confirmation" | "bol" | "pod" | "invoice" | "other"
  fileUrl     String
  fileName    String
  uploadedAt  DateTime @default(now())
  notes       String?

  @@index([loadId])
}
