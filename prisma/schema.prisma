generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  driverId           Int?      @unique
  email              String    @unique
  password           String?   // null = pending registration (driver sets own password via mobile)
  userRole           Int
  adminId            Int?
  fullName           String?
  phoneNumber        String?   @unique @db.VarChar(20)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  exports            Export[]
  uploads            Upload[]
  payrolls           Payroll[]
  disputes           Dispute[]
  orderDisputes      OrderDispute[]
  resetCodeHash        String?
  resetCodeExpiresAt   DateTime?
  resetCodeAttempts    Int       @default(0)
  pushToken            String?
  salaryType           String?
  fixedSalary          Float?
  schedule             String[]
  status               String?   @default("Active")
  driverAvailableToday Boolean?  @default(false)
  insuranceNumber      String?
  insuranceExpiry      DateTime?
  registrationNumber   String?
  registrationExpiry   DateTime?
  licenseNumber        String?
  licenseExpiry        DateTime?
  state                String?
  operatingType        String?   // "individual" | "company"
  // --- New: self-registration flow ---
  emailVerified        Boolean   @default(false)
  emailOtpHash         String?
  emailOtpExpiresAt    DateTime?
  poolStatus           String?   // null | "pending" | "approved" | "rejected"
  poolEntry            DriverPool?
}

model Upload {
  id         Int      @id @default(autoincrement())
  driverId   Int?
  user       User?    @relation(fields: [driverId], references: [driverId])
  barcode    String
  sequenceNo String?
  lastevent  String?
  address    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  salaryType String?
  rate       Float?
  pieces     Int?
  zipCode    String?
  city       String?
  exports    Export[]

  @@index([driverId, createdAt])
  @@index([driverId, lastevent])
}

model Export {
  id             Int      @id @default(autoincrement())
  driverId       Int
  barcode        String
  address        String
  gpsLocation    String?
  expectedLat    Float?
  expectedLng    Float?
  distanceKm     Float?
  status         String?
  matches        String
  googleMapsLink String?
  uploadId       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [driverId], references: [id])
  upload         Upload?  @relation(fields: [uploadId], references: [id])
}

model Payroll {
  id              Int      @id @default(autoincrement())
  driverId        Int
  driverName      String
  zipCode         String?
  zipBreakdown    Json?
  address         String?
  weekNumber      Int // <-- CHANGED: Was Int?
  payPeriod       String?
  salaryType      String?
  stopsCompleted  Int
  totalDeliveries Int?
  amount          Float
  totalDeduction  Float    @default(0)
  totalBonus      Float    @default(0)
  netPay          Float
  remarks         String?
  bonusRemarks    String?
  createdAt       DateTime @default(now())

  driver User @relation(fields: [driverId], references: [driverId])

  @@unique([driverId, weekNumber])
  @@index([weekNumber])
}

model Route {
  id                        Int      @id @default(autoincrement())
  routeNumber               String?  @map("route_number") // e.g. '222'
  description               String   @map("description") // e.g. 'PAWCUTUCK'
  ratePerStop               Float    @map("rate_per_stop") // e.g. 2.35
  territory                 String?  @map("territory") // e.g. 'T1'
  zone                      String?  @map("zone") // e.g. 'Zone B'
  status                    String?  @map("status") // e.g. 'Active'
  baseRate                  Float?   @map("base_rate") // e.g. 'Active'
  baseRateCompanyVehicle    Float?   @map("base_rate_company_vehicle") // e.g. 'Active'
  schedule                  String[] @map("schedule") // array of weekdays
  zipCode                   String[] @map("zip_code") // array of ZIPs ['6379']
  dayOfTheWeek              String?  @map("day_of_the_week") // e.g. 'Tuesday'
  routeScheduledForToday    String?  @map("route_scheduled_for_today") // e.g. 'Yes'
  ratePerStopCompanyVehicle Float?   @map("rate_per_stop_company_vehicle") // e.g. 2
  route                     String?  @map("route") // e.g. '222 (PAWCUTUCK)'
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}


model Dispute {
  id         Int              @id @default(autoincrement())
  driverId   Int
  driverName String
  title      String
  status     String           @default("open")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   DisputeMessage[]
  driver     User             @relation(fields: [driverId], references: [driverId])

  @@index([driverId])
}

model DisputeMessage {
  id         Int      @id @default(autoincrement())
  disputeId  Int
  senderRole String
  senderName String
  content       String
  attachmentUrl String?
  createdAt     DateTime @default(now())
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model OrderDispute {
  id                Int      @id @default(autoincrement())
  driverId          Int
  driverName        String
  date              DateTime
  orderNumber       String
  expectedLocation  String
  deliveredLocation String
  imageUrl          String?
  status            String   @default("open")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  driver            User     @relation(fields: [driverId], references: [driverId])

  @@index([driverId])
}

model DriverDocument {
  id          Int      @id @default(autoincrement())
  driverId    Int
  fileName    String
  storedName  String
  description String
  fileUrl     String
  status      String   @default("pending") // "pending" | "verified"
  createdAt   DateTime @default(now())
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  driverId   Int
  driverName String
  date       DateTime
  reason     String
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([driverId])
  @@index([status])
}

model SpecialOrder {
  id              Int      @id @default(autoincrement())
  routeName       String
  stops           Int
  date            DateTime
  price           Float
  status          String   @default("pending") // "pending" | "accepted" | "rejected"
  targetType      String   // "specific" | "all"
  targetDriverIds Json?    // array of driverIds e.g. [12345, 254306]
  rejectedBy      Json?    // array of driverIds who rejected
  acceptedBy      Int?
  acceptedByName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PayrollAdjustment {
  id         Int      @id @default(autoincrement())
  driverId   Int
  weekNumber Int
  date       String   // YYYY-MM-DD — the specific day this applies to
  type       String   // "deduction" | "bonus"
  amount     Float
  reason     String
  createdAt  DateTime @default(now())

  @@index([driverId, weekNumber])
  @@index([driverId, date])
}

model AssignDraft {
  id        Int      @id @default(autoincrement())
  name      String
  rows      Json     // Array of { driverId: number, routes: string[] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollRateOverride {
  id           Int      @id @default(autoincrement())
  driverId     Int
  zipCode      String
  date         String   // YYYY-MM-DD stored as string to avoid timezone issues
  originalRate Float
  newRate      Float
  changedBy    String
  changedAt    DateTime @default(now())

  @@unique([driverId, zipCode, date])
}

model DriverSchedule {
  id         Int      @id @default(autoincrement())
  driverId   Int
  driverName String
  date       String   // YYYY-MM-DD
  status     String   @default("available") // "available" | "off"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([driverId, date])
  @@index([date])
}

model DriverPool {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id])
  fullName         String
  email            String
  phoneNumber      String?
  state            String?
  operatingType    String?   // "individual" | "company"
  // Insurance
  insuranceNumber  String?
  insuranceExpiry  DateTime?
  insuranceDocUrl  String?
  // Registration
  registrationNumber String?
  registrationExpiry DateTime?
  registrationDocUrl String?
  // License
  licenseNumber    String?
  licenseExpiry    DateTime?
  licenseDocUrl    String?
  // Legacy single-doc fields (kept nullable for backward compat)
  docName          String?
  docUrl           String?
  status           String    @default("pending") // "pending" | "approved" | "rejected"
  assignedDriverId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}
